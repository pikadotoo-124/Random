rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.uid == userId &&
        data.playerName is string &&
        data.playerName.size() >= 3 &&
        data.playerName.size() <= 16 &&
        (data.gender == 'male' || data.gender == 'female');
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if false;

      // Subcollection for playerState and worldState
      match /gameData/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(docId) && (docId == 'playerState' || docId == 'worldState');
        allow delete: if false;
      }
    }
  }
}
