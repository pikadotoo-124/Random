# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID: Firebase project used for WebSocket JWT token verification.
FIREBASE_PROJECT_ID="intrepid-cyclist-mbvhw"

# FIREBASE_DATABASE_ID: Named Firestore database ID used for server-side Cloud Save persistence.
FIREBASE_DATABASE_ID="ai-studio-randomcity-5937d77e-b2d8-41e1-a0e0-e3c9da9af426"

# Server-Side Firebase Service Account Credentials (required for POST /api/player/save Firestore commits).
# Provide either FIREBASE_SERVICE_ACCOUNT_JSON OR (FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY).
# Configure via .env locally or `wrangler secret put` in Cloudflare Workers. Never commit real secrets.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# VITE_WS_URL: Optional override for production WebSocket URL (defaults to wss://<current-host>/ws).
# Only needed if frontend and Cloudflare Worker are hosted on different domains.
# VITE_WS_URL="wss://random-city-multiplayer.<your-subdomain>.workers.dev/ws"

# Step 38B Cutover & Instant Rollback Flags (defaults to DO Primary when unset)
# Server-side: "do_primary" (default) or "legacy_firestore" (instant rollback)
DO_SAVE_CUTOVER_MODE="do_primary"
# Client-side: "true" (default) or "false" (instant rollback to legacy Firestore reads)
VITE_DO_SAVE_CUTOVER_ENABLED="true"

